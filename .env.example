# ============================================
# App Configuration
# ============================================
SECRET_KEY=generate-a-random-secret-key-here
JWT_SECRET_KEY=generate-a-random-jwt-secret-here
ADMIN_SECRET=change-me-admin-secret
BASE_URL=http://localhost:8000
# Comma-separated browser origins allowed to send credentialed cookies.
# Defaults in app.py match production + local Flask ports if this is unset.
ALLOWED_ORIGINS=https://landmarkvts.in,https://www.landmarkvts.in,http://localhost:8000,http://localhost:10000,http://127.0.0.1:8000,http://127.0.0.1:10000

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite:///landmark.db
DEBUG=True

# ============================================
# Razorpay (Test Keys)
# ============================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret